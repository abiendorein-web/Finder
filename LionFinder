                    local idMatch = item.id and string.find(item.id, q, 1, true)
                    local pathMatch = item.path and string.find(string.lower(item.path), q, 1, true)
                    if not (nameMatch or idMatch or pathMatch) then match = false end
                end
                if match then table.insert(filtered, item) end
            end
