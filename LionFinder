local GENERIC_NAMES = {
    ["ImageLabel"]=true, ["ImageButton"]=true, ["Frame"]=true,
    ["Icon"]=true, ["Image"]=true, ["Thumbnail"]=true, ["Logo"]=true,
    ["Preview"]=true, ["Banner"]=true, ["Photo"]=true, ["Picture"]=true,
    ["Background"]=true, ["Texture"]=true, ["Decal"]=true, ["Sound"]=true,
    ["MeshPart"]=true, ["SpecialMesh"]=true, ["Animation"]=true,
    ["ParticleEmitter"]=true, ["Beam"]=true, ["Trail"]=true,
    ["Part"]=true, ["Mesh"]=true, ["Button"]=true, ["Contents"]=true,
}

local function isGeneric(name)
    if not name then return true end
    if GENERIC_NAMES[name] then return true end
    if name:match("^Icon%d+$") then return true end
    if name:match("^Image%d+$") then return true end
    if name:match("^Frame%d+$") then return true end
    if name:match("^Grid%d+$") then return true end
    if #name < 3 then return true end
    return false
end

local function fallbackName(obj, id)
    local raw = tostring(obj.Name or "Unknown")
    if not isGeneric(raw) then return raw end
    local context = {}
    local parent = obj.Parent
    local depth = 0
    while parent and depth < 4 do
        local pName = tostring(parent.Name or "")
        if not isGeneric(pName) then
            table.insert(context, 1, pName)
        end
        parent = parent.Parent
        depth = depth + 1
    end
    if #context > 0 then
        return table.concat(context, " · ")
    end
    return obj.ClassName .. " · " .. (id and id:sub(1, 6) or "?")
end

