        local function checkObj(obj)
            pcall(function()
                local src
                if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then src = obj.Image
                elseif obj:IsA("Decal") or obj:IsA("Texture") then src = obj.Texture
                elseif obj:IsA("Sound") then src = obj.SoundId
                elseif obj:IsA("MeshPart") or obj:IsA("SpecialMesh") then src = obj.MeshId
                elseif obj:IsA("Animation") then src = obj.AnimationId
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then src = obj.Texture
                end
                if src and string.find(src, searchId, 1, true) then
                    table.insert(found, {name = obj.Name, id = searchId, path = obj:GetFullName(), isRemote = false})
                end
            end)
        end

